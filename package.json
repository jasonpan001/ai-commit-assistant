{
  "name": "ai-commit-assistant",
  "displayName": "AI Commit Assistant",
  "description": "AI-powered Git commit message generator supporting Claude, OpenAI-compatible APIs, and custom commit conventions.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiCommit.generateMessage"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiCommit.generateMessage",
        "title": "AI Commit: Generate Message"
      }
    ],
    "configuration": {
      "title": "AI Commit",
      "properties": {
        "aiCommit.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Anthropic Messages API",
            "OpenAI-compatible Chat Completions API"
          ],
          "default": "openai-compatible",
          "description": "LLM API provider used to generate commit messages."
        },
        "aiCommit.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Provider base URL. Leave empty to use the selected provider's default."
        },
        "aiCommit.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "API key for the selected provider. This is sensitive data; store it only in trusted machine-local settings and never commit it to source control."
        },
        "aiCommit.model": {
          "type": "string",
          "default": "",
          "description": "Model identifier sent to the selected provider."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
